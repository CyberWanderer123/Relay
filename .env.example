# Port the local server listens on (ignored on Vercel).
PORT=8787

# Public origin used in every link Relay hands out. Must be HTTPS in production.
# On Vercel it defaults to the project's production domain if left unset.
RELAY_BASE_URL=http://localhost:8787

# The single creator key. Required for /api and /mcp.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
RELAY_OWNER_KEY=

# Database. Locally a SQLite file; in production a Turso database.
#   Local:  file:./data/relay.db   (the default if unset)
#   Turso:  libsql://<db>-<org>.turso.io   plus TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=file:./data/relay.db
TURSO_AUTH_TOKEN=

# Read client IPs from X-Forwarded-For. Defaults to on for Vercel, off elsewhere.
# Turn it on only behind a proxy you trust.
# RELAY_TRUST_PROXY=0

# Form submissions allowed per IP per minute.
RELAY_SUBMIT_PER_MINUTE=10

# For the local MCP program only: talk to a hosted Relay instead of the database directly.
# RELAY_URL=https://your-relay.vercel.app
